rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only verified Google accounts count. The email is always stored in lower case.
    function email() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        ? request.auth.token.email.lower()
        : null;
    }

    function isAdmin() {
      return email() != null
        && exists(/databases/$(database)/documents/admins/$(email()));
    }

    // Client profile, keyed by the client's Google (Gmail) address.
    match /clients/{clientId} {
      allow read: if isAdmin() || (email() != null && email() == clientId);
      allow write: if isAdmin();

      // A paused client can no longer see their files.
      match /files/{fileId} {
        allow read: if isAdmin() || (
          email() != null && email() == clientId
          && get(/databases/$(database)/documents/clients/$(clientId)).data.active == true
        );
        allow write: if isAdmin();
      }
    }

    // Admins are added by hand in the Firebase console, never from the site.
    match /admins/{adminId} {
      allow read: if email() != null && email() == adminId;
      allow write: if false;
    }
  }
}
