{
  "name": "bhangdiya-portal",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --mode emulator",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-bhangdiya",
    "seed": "node scripts/seed-emulator.mjs",
    "build": "vite build",
    "test": "firebase emulators:exec --only firestore --project demo-bhangdiya \"vitest run\"",
    "deploy:rules": "firebase deploy --only firestore:rules --project bhangdiya-portal",
    "deploy:site": "vite build && wrangler deploy"
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "firebase-tools": "^15.35.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
